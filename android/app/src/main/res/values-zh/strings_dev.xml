    <string name="dev_title">开发者选项</string>

    <string name="dev_section_mic">车机麦克风</string>
    <string name="dev_mic_vr_title" translatable="false">MODULE_STATUS VR</string>
    <string name="dev_mic_vr_sub">与 MIC_RECORD_* 一起发送 VR 1/0（类似百度）</string>

    <string name="dev_section_meta">车机上的元数据（USB 重新连接后生效）</string>
    <string name="dev_meta_music_title">音乐</string>
    <string name="dev_meta_music_sub">曲目、封面和进度：MEDIA_INFO / MEDIA_PROGRESS_BAR</string>
    <string name="dev_meta_navi_title">导航</string>
    <string name="dev_meta_navi_sub">转弯和距离：车机订阅时发送 NAVI_NEXT_TURN_INFO</string>
    <string name="dev_meta_icon_title">字段 6：图标</string>
    <string name="dev_meta_icon_sub">turnIconData 字节，PNG 箭头（类似百度 8.6.7）</string>
    <string name="dev_meta_time_title">字段 6：时间</string>
    <string name="dev_meta_time_sub">到机动点的时间，int32，单位秒（类似 apollo-DuerOS）</string>
    <string name="dev_meta_progress_title">以秒为单位的进度</string>
    <string name="dev_meta_progress_sub">MEDIA_PROGRESS_BAR 以秒而非毫秒为单位（如果车机显示的时间放大了 1000 倍）</string>

    <string name="dev_section_music_chunk">音乐数据包大小（实验性）</string>
    <string name="dev_music_chunk_note">数值越小，车机上的缓冲越小，但 USB 上的数据包越多。如果声音卡顿，请切换回“按 Android Auto 发送的方式”</string>
    <string name="dev_section_voice_chunk">语音数据包大小（实验性）</string>
    <string name="dev_voice_chunk_note">助手回复和导航提示。自动：VW CNS2 Delphi 上为 1024 B，其他情况按 AA 发送的方式</string>
    <string name="dev_section_tts_preroll">提示音前的静音（实验性）</string>
    <string name="dev_tts_preroll_note">在提示音开始后补零，以便车机打开音频通路。自动：VW 上为 400 ms</string>
    <string name="dev_section_touch_decimation">触摸抽稀（实验性）</string>
    <string name="dev_touch_decimation_note">跳过每隔一个 MOVE 事件：车机每秒最多发送约 70 个事件，而视频最高 30 fps。手指抬起前的最后一个点绝不会丢失。</string>


